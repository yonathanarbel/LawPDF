.env
.env.*
!.env.example

# Build and package outputs
/target*/
/dist/
/PUBLIC-SOURCE-MANIFEST.json
/output/
/liquid2-cache/
/.lawpdf/
/android/.gradle/
/android/**/build/
__pycache__/
*.py[cod]
*$py.class

# Machine-local workspace configuration and evaluation inputs
/.cargo/config.toml
/to-evaluate/

# Local/generated archives and platform metadata
/lawpdf-code-root.tar.gz
._*
**/._*

# Local corpora and generated model artifacts
/top_law_review_pdfs/*.pdf
*.pt
*.joblib
*.onnx
*.safetensors
*.ckpt
*.bin
*.pkl

